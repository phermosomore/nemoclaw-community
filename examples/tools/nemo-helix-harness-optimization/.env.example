# Copy to .env; never commit filled credentials. The Analyst loads .env from cwd.
# Export Helix/Harbor settings in your shell separately.
NHX_BASE_URL=http://127.0.0.1:9080
NHX_WORKSPACE=default
NEMO_AGENTS_GATEWAY_READ_TIMEOUT=1800

# Standalone Analyst inference (separate from Intake authentication).
# Replace the model alias with a tool-calling, structured-output gateway model.
INSIGHT_AGENT_MODEL=openai/REPLACE_WITH_YOUR_MODEL_NAME
INSIGHT_AGENT_API_BASE=http://127.0.0.1:9080/apis/inference-gateway/v2/workspaces/default/openai/-/v1
INSIGHT_AGENT_API_KEY=
# Intake connector's upstream compatibility name; required only with auth.
NMP_ACCESS_TOKEN=

# FreeCAD and the retained Harbor adapter.
FREECAD_RPC=http://127.0.0.1:9875
FREECAD_BIN=
CAD_SCORER=
CAD_AGENT_TIMEOUT=3600
CAD_AGENT_TRACE_WAIT=3600
# Optional absolute path to the Helix CLI for the Harbor adapter.
NEMO_CLI=
# Direct config invocation requires the model API key env named in agent.yaml.
NEMO_AGENTS_IGW_API_KEY=
